      have "odd_set_cover lab_osc (ex \<inter> G)"
        apply(intro *)
        using \<open>examined_have_odd_verts_invar ex flabel\<close>
        using examined_have_odd_verts_invar_def
        by blast
      have "finite lab_osc"
