          have "\<exists>s\<in>osc. (s \<inter> e' \<noteq> {} \<and> card s = 1) \<or> e' \<subseteq> s" if "e' \<in> G - ex" for e'
          proof-
            have "e' = e \<or> e' \<in> M' \<or> e' \<notin> M"
              using M' v1v2 that
              by auto
            then consider (e) "e' = e" | (M') "e' \<in> M'" | (unmatched) "e' \<notin> M"
