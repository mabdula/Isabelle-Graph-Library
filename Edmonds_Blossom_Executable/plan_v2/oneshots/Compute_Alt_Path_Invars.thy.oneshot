                (even_unlab) "((\<exists>v\<in>{va,vb}.\<exists>r. flabel v = Some (r, Even)) \<and> (\<exists>v\<in>{va,vb}. flabel v = None))"|
                (nones) "(\<forall>v\<in>{va,vb}. flabel v = None)"
                by presburger
