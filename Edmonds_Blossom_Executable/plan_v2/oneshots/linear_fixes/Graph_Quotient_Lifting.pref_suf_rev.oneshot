text \<^marker>\<open>provenance ai\<close> \<open>The function @{const pref_suf} appends each element at the end of the prefix, which
  takes time quadratic in the length of the list. The following variant accumulates the prefix in
  reverse order and reverses it once at the end, in linear time. It provides the code equation of
  @{const pref_suf}.\<close>

fun \<^marker>\<open>provenance ai\<close> pref_suf_rev where
  "pref_suf_rev pref v [] = (rev pref, [])"
| "pref_suf_rev pref v (a # l) = (if a = v then (rev pref, l) else pref_suf_rev (a # pref) v l)"

lemma \<^marker>\<open>provenance ai\<close> pref_suf_rev_eq:
  "pref_suf_rev pref v l = pref_suf (rev pref) v l"
  by (induction l arbitrary: pref) auto

lemma \<^marker>\<open>provenance ai\<close> pref_suf_code[code]:
  "pref_suf pref v l = pref_suf_rev (rev pref) v l"
  by (simp add: pref_suf_rev_eq)

