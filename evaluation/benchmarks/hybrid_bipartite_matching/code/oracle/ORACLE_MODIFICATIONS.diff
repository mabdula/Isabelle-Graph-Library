+#ifdef	CSA_LIBRARY
+/*
+Library entry (added for the certifying assignment solver): solve the
+instance given by arrays (see parse_arrays() in parse.c) with the
+default scale factor, without printing anything.
+
+Termination guard: CSA does not terminate if the instance has no
+perfect matching (see README), because the prices of the right-hand
+nodes then decrease without bound within one refine. A relabeling that
+takes a price below price_floor (set before each refine, see below)
+stops the computation (csa_aborted). If a perfect matching exists, the
+prices stay above the floor; a wrong firing would only cost time, since
+the caller then falls back on a verified solver.
+
+Returns 0 if CSA finished, 1 if the guard fired, 2 if out of memory.
+*/
+double	price_floor;
+int	csa_aborted;
+
+int	csa_solve_arrays(nl, nr, arcs, tl, hd, cs)
+
+unsigned	nl, nr, arcs;
+const long	*tl, *hd, *cs;
+
+{
+extern	unsigned long	parse_arrays();
+extern	stack		st_create();
+#ifdef	QUEUE_ORDER
+extern	queue		q_create();
+#endif
+extern	int	update_epsilon();
+extern	void	refine();
+unsigned long	max_cost;
+rhs_ptr	r_v;
+#ifdef	QUICK_MIN
+lhs_ptr	l_v;
+void	best_build();
+#endif
+
+max_cost = parse_arrays(nl, nr, arcs, tl, hd, cs);
+if (max_cost == ~0UL) return(2);
+/*
+With all costs zero, parse() would start (and end) at epsilon 0
+without matching anything.
+*/
+epsilon = max_cost > 0 ? (double) max_cost : 1.0;
+scale_factor = DEFAULT_SCALE_FACTOR;
+po_cost_thresh = 2.0 * (double) n * (scale_factor + 1);
+create_active(n);
+#ifdef	QUICK_MIN
+for (l_v = head_lhs_node; l_v != tail_lhs_node; l_v++)
+  if (!l_v->node_info.few_arcs)
+    best_build(l_v);
+rebuilds = 0;
+#endif
+
+#ifdef	PREC_COSTS
+min_epsilon = 2.0 / (double) (n + 1);
+#else
+min_epsilon = 1.0 / (double) (n + 1);
+#endif
+csa_aborted = FALSE;
+
+while (epsilon > min_epsilon && !csa_aborted)
+  {
+  (void) update_epsilon();
+  /*
+  The floor for this refine: the lowest price at its start, minus
+  16 (n + 1) (scale_factor + 1) max(epsilon, 1). For epsilon >= 1 this
+  is eight times the bound CSA itself uses for pricing out
+  (po_cost_thresh * epsilon); below 1, the integer cost gaps dominate
+  the price changes, hence the max. On feasible instances the drops
+  measured stay well below it; without a perfect matching, the first
+  refine never ends and the prices fall without bound.
+  */
+  price_floor = head_rhs_node->p;
+  for (r_v = head_rhs_node; r_v != tail_rhs_node; r_v++)
+    if (r_v->p < price_floor) price_floor = r_v->p;
+  price_floor -= 16.0 * (double) (n + 1) * (scale_factor + 1.0) *
+		 (epsilon > 1.0 ? epsilon : 1.0);
+  refine();
+  }
+return(csa_aborted ? 1 : 0);
+}
+
+/* The rhs node (0-based) lhs node i is matched to, or -1. */
+long	csa_lhs_match(i)
+
+unsigned	i;
+
+{
+lr_aptr	a = head_lhs_node[i].matched;
+
+return(a == NULL ? -1 : (long) (a->head - head_rhs_node));
+}
+
+/* The price of rhs node j (0-based). */
+double	csa_rhs_price(j)
+
+unsigned	j;
+
+{
+return(head_rhs_node[j].p);
+}
+
+void	csa_release()
+
+{
+(void) free((char *) head_lr_arc);
+(void) free((char *) head_lhs_node);
+(void) free((char *) head_rhs_node);
+#ifdef	QUEUE_ORDER
+(void) free((char *) active->storage);
+#else
+(void) free((char *) active->bottom);
+#endif
+(void) free((char *) active);
+}
+#endif	/* CSA_LIBRARY */
