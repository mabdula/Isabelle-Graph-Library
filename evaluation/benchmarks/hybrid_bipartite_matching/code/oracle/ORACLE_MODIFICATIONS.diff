+#ifdef	CSA_LIBRARY
+/*
+Library entry (added for the certifying assignment solver): the same
+data structures as parse() builds, from arrays instead of stdin.
+Arc i runs from lhs node tl[i] (0-based, < nl) to rhs node hd[i]
+(0-based, < nr) and costs cs[i]. Returns the maximum absolute cost,
+as parse() does. Only the configuration the solver builds is
+supported (precise costs, no reverse arcs); NULL on out of memory is
+reported by returning ~0UL.
+*/
+#if	defined(STORE_REV_ARCS) || defined(ROUND_COSTS)
+#error	"parse_arrays supports precise costs without reverse arcs only"
+#endif
+
+unsigned long	parse_arrays(nl, nr, arcs, tl, hd, cs)
+
+unsigned	nl, nr, arcs;
+const long	*tl, *hd, *cs;
+
+{
+unsigned	i, tail;
+long	*lhs_degree, cost;
+unsigned long	max_cost = 0;
+lr_aptr	a;
+lhs_ptr	l_v;
+rhs_ptr	r_v;
+
+n = nl + nr;
+m = arcs;
+head_lr_arc = (lr_aptr) malloc((m + 1) * sizeof(struct lr_arc));
+tail_lr_arc = head_lr_arc + m;
+head_lhs_node = (lhs_ptr) malloc((nl + 1) * sizeof(struct lhs_node));
+tail_lhs_node = head_lhs_node + nl;
+head_rhs_node = (rhs_ptr) malloc((nr + 1) * sizeof(struct rhs_node));
+tail_rhs_node = head_rhs_node + nr;
+lhs_degree = (long *) malloc((nl + 1) * sizeof(long));
+if ((head_lr_arc == NULL) || (head_lhs_node == NULL) ||
+    (head_rhs_node == NULL) || (lhs_degree == NULL))
+  return(~0UL);
+
+for (tail = 0; tail < nl; tail++)
+  lhs_degree[tail] = 0;
+for (i = 0; i < m; i++)
+  {
+  lhs_degree[tl[i]]++;
+  cost = cs[i] < 0 ? -cs[i] : cs[i];
+  if ((unsigned long) cost > max_cost) max_cost = cost;
+  }
+
+a = head_lr_arc;
+for (tail = 0, l_v = head_lhs_node; l_v != tail_lhs_node; l_v++, tail++)
+  {
+  l_v->priced_out = l_v->first = a;
+  l_v->matched = NULL;
+  a += lhs_degree[tail];
+#ifdef	QUICK_MIN
+  if (lhs_degree[tail] < NUM_BEST + 1)
+    l_v->node_info.few_arcs = TRUE;
+  else
+    l_v->node_info.few_arcs = FALSE;
+#endif
+  }
+tail_lhs_node->priced_out = a;
+
+for (r_v = head_rhs_node; r_v != tail_rhs_node; r_v++)
+  {
+  r_v->node_info.priced_in = TRUE;
+  r_v->matched = NULL;
+  r_v->p = 0.0;
+  }
+
+for (i = m; i-- > 0; )
+  {
+  l_v = head_lhs_node + tl[i];
+  a = l_v->first + (--lhs_degree[tl[i]]);
+  a->head = head_rhs_node + hd[i];
+#ifdef	MIN_COST
+  a->c = (double) cs[i];
+#else
+  a->c = (double) -cs[i];
+#endif
+#ifdef	USE_SP_AUG_FORWARD
+  a->tail = l_v;
+#endif
+  }
+
+(void) free((char *) lhs_degree);
+
+return(max_cost);
+}
+#endif	/* CSA_LIBRARY */
